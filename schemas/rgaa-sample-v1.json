{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inem0o.github.io/cdpx/schema/rgaa-sample-v1.json",
  "title": "cdpx RGAA declared sample",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pages"],
  "properties": {
    "schema": {"const": "cdpx.rgaa.sample/v1"},
    "rgaa_version": {"const": "4.1.2", "default": "4.1.2"},
    "scope": {"enum": ["passive", "interactive", "privileged"], "default": "passive"},
    "engine": {"enum": ["native", "hybrid"], "default": "native"},
    "base_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
          "url": {"type": "string", "minLength": 1},
          "tests": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$"}
          }
        }
      }
    }
  }
}
