{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inem0o.github.io/cdpx/schema/rgaa-sample-result-v1.json",
  "type": "object",
  "required": ["schema", "execution_status", "rgaa_version", "sample", "summary", "themes", "criteria", "tests", "pages", "limitations"],
  "properties": {
    "schema": {"const": "cdpx.rgaa.sample-result/v1"},
    "execution_status": {"enum": ["complete", "partial", "error"]},
    "rgaa_version": {"const": "4.1.2"},
    "sample": {"$ref": "rgaa-sample-plan-v1.json"},
    "summary": {"type": "object"},
    "themes": {"type": "array", "minItems": 13, "maxItems": 13},
    "criteria": {"type": "array", "minItems": 106, "maxItems": 106},
    "tests": {"type": "array", "minItems": 258, "maxItems": 258},
    "pages": {"type": "array", "minItems": 1, "maxItems": 50},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "_cdpx": {"type": "object"}
  }
}
