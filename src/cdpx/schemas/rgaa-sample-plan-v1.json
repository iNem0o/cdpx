{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inem0o.github.io/cdpx/schema/rgaa-sample-plan-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "rgaa_version", "source", "scope", "engine", "required_authority", "pages", "page_count", "planned_actions", "maximum_interactive_actions", "composition_digest"],
  "properties": {
    "schema": {"const": "cdpx.rgaa.sample-plan/v1"},
    "rgaa_version": {"const": "4.1.2"},
    "source": {"type": "string", "minLength": 1},
    "scope": {"enum": ["passive", "interactive", "privileged"]},
    "engine": {"enum": ["native", "hybrid"]},
    "required_authority": {"enum": ["observation", "interaction", "privileged"]},
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "tests", "collectors", "planned_actions", "required_authority"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
          "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
          "tests": {
            "type": ["array", "null"],
            "minItems": 1,
            "maxItems": 258,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$"}
          },
          "collectors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "planned_actions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["navigations", "interactions", "total"],
            "properties": {
              "navigations": {"const": 1},
              "interactions": {"type": "integer", "minimum": 0},
              "total": {"type": "integer", "minimum": 1}
            }
          },
          "required_authority": {"enum": ["observation", "interaction", "privileged"]}
        }
      }
    },
    "page_count": {"type": "integer", "minimum": 1, "maximum": 50},
    "planned_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["navigations", "interactions", "total"],
      "properties": {
        "navigations": {"type": "integer", "minimum": 1, "maximum": 50},
        "interactions": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1}
      }
    },
    "maximum_interactive_actions": {"type": "integer", "minimum": 0},
    "composition_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
